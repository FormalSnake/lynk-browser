{
  "manifest_version": 3,
  "name": "Pair Probe",
  "version": "1.0.0",
  "description": "A second extension, so a drive can prove two of them run at once.",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
