---
import { Image } from "astro:assets";
import icon from "@/assets/icon.png";

const links = [
  { href: "#tour", label: "Tour" },
  { href: "#shortcuts", label: "Shortcuts" },
  { href: "#install", label: "Install" },
];
---

<header class="pointer-events-none fixed inset-x-0 top-4 z-40 flex justify-center px-4">
  <nav
    aria-label="Primary"
    class="pointer-events-auto flex items-center gap-1 rounded-full bg-[oklch(0.17_0.028_266/0.72)] p-1.5 shadow-[0_0_0_1px_oklch(1_0_0/0.08),0_8px_32px_oklch(0_0_0/0.4)] backdrop-blur-xl"
  >
    <a href="#top" class="flex items-center gap-2 rounded-full py-1 pr-3 pl-1 font-heading text-[0.9375rem] font-semibold">
      <Image src={icon} alt="" width={56} height={56} class="size-7" />
      Lynk
    </a>
    <ul class="hidden items-center sm:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="rounded-full px-3 py-1.5 text-sm text-muted-foreground transition-colors duration-150 hover:text-foreground"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="https://github.com/FormalStudio/lynk-browser"
      class="ml-1 rounded-full bg-foreground px-3.5 py-1.5 text-sm font-medium text-background transition-transform duration-150 ease-out active:scale-[0.96]"
    >
      GitHub
    </a>
  </nav>
</header>
